{
  "name": "palmos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/server/dashboardApi.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "package:agent:build": "tsc -p packages/agent/tsconfig.json",
    "package:agent:pack": "npm --cache /tmp/palmos-npm-cache pack --workspace @getpalmos/agent --dry-run",
    "package:mcp:build": "tsc -p packages/mcp/tsconfig.json",
    "package:mcp:pack": "npm --cache /tmp/palmos-npm-cache pack --workspace @getpalmos/mcp --dry-run",
    "palmos:init": "node --import tsx src/cli/initPalmos.ts",
    "palmos:wallet": "node --import tsx src/cli/generatePusdWallet.ts",
    "palmos:readiness": "node --import tsx src/cli/checkPusdReadiness.ts",
    "palmos:storage": "node --import tsx src/cli/manageStorage.ts",
    "palmos:postgres": "node --import tsx src/cli/managePostgres.ts",
    "palmos:action-requests": "node --import tsx src/cli/reconcileActionRequests.ts",
    "palmos:action-lifecycle": "node --import tsx src/cli/reconcileNativeActionRequests.ts",
    "palmos:settlements": "node --import tsx src/cli/reconcileSettlements.ts",
    "x402:wallet": "bun src/cli/generateX402Wallet.ts",
    "xmtp:wallet": "node --import tsx src/cli/generateEvmWallet.ts",
    "pusd:server": "bun src/cli/runLocalPusdServer.ts",
    "x402:server": "bun src/cli/runLocalX402Server.ts",
    "ows:proof": "bun src/cli/runOwsProof.ts",
    "xmtp:test": "node --import tsx src/cli/sendXmtpTestAlert.ts",
    "xmtp:resolve": "node --import tsx src/cli/resolveXmtpIdentity.ts",
    "agent:live": "node --import tsx src/cli/runPalmosWorker.ts",
    "agent:external": "node --import tsx src/cli/runExternalAgent.ts",
    "palmos:worker": "node --import tsx src/cli/runPalmosWorker.ts",
    "palmos:external-agent": "node --import tsx src/cli/runExternalAgent.ts",
    "judge:seed": "node --import tsx src/cli/seedJudgeWorkspace.ts",
    "approval:pending": "node --import tsx src/cli/reviewPendingApprovals.ts",
    "showcase:live": "bun src/cli/runHackathonShowcase.ts",
    "showcase:pending": "SHOWCASE_AUTO_RESOLVE_APPROVALS=0 bun src/cli/runHackathonShowcase.ts",
    "dashboard:export": "bun src/cli/exportDashboard.ts",
    "frontend:snapshot": "bun src/cli/syncFrontendSnapshot.ts",
    "dashboard:api": "node --import tsx src/server/dashboardApi.ts",
    "palmos:umbra-private": "node --import tsx src/cli/runUmbraPrivateProof.ts",
    "palmos:private": "node --import tsx src/cli/runUmbraPrivateProof.ts"
  },
  "dependencies": {
    "@open-wallet-standard/core": "^1.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@umbra-privacy/sdk": "^4.0.0",
    "@umbra-privacy/web-zk-prover": "^2.0.1",
    "@xmtp/node-sdk": "^6.0.0",
    "bs58": "^6.0.0",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "snarkjs": "^0.7.6",
    "tsx": "^4.21.0",
    "viem": "^2.21.26",
    "x402-express": "^1.1.0",
    "x402-fetch": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.2"
  }
}
